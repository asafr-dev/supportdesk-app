# Database
DATABASE_URL=postgresql://app:app@localhost:5432/supportdesk
PRISMA_HIDE_UPDATE_MESSAGE=1

# Auth
APP_URL=http://localhost:3000
AUTH_COOKIE_NAME=sd_session
SESSION_TTL_HOURS=72

# Demo seed user password (used by prisma seed + login form prefill).
# Required (app fails fast if missing). Example value below is safe because this is demo-only.
DEMO_PASSWORD=supportdesk-demo